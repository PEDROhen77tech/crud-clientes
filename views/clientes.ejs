<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Clientes | CRUD</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <main class="container">
    <header><div><span class="eyebrow">PAINEL ADMINISTRATIVO</span><h1>Gerenciamento de clientes</h1><p>Cadastre, consulte, edite e exclua clientes.</p></div><span class="status">● API conectada</span></header>
    <section class="stats"><div><small>CLIENTES CADASTRADOS</small><strong id="total">—</strong></div><div><small>ENDPOINT</small><code>GET /clientes</code></div></section>
    <section class="panel"><div class="panel-header"><h2>Clientes</h2><button id="novo" class="primary">+ Novo cliente</button></div><p id="mensagem" role="status"></p><div class="table-wrap"><table><thead><tr><th>ID</th><th>NOME</th><th>EMAIL</th><th>AÇÕES</th></tr></thead><tbody id="lista"><tr><td colspan="4">Carregando...</td></tr></tbody></table></div></section>
    <footer>Node.js + Express • MVC • Firebase</footer>
  </main>
  <dialog id="modal"><form id="form"><div class="modal-head"><h2 id="tituloModal">Novo cliente</h2><button type="button" class="close" id="fechar" aria-label="Fechar">×</button></div><label>Nome<input id="nome" name="nome" maxlength="120" required placeholder="Nome completo"></label><label>Email<input id="email" name="email" type="email" maxlength="200" required placeholder="exemplo@email.com"></label><div class="actions"><button type="button" id="cancelar">Cancelar</button><button type="submit" class="primary" id="salvar">Salvar cliente</button></div></form></dialog>
  <script src="/js/clientes.js"></script>
</body>
</html>
